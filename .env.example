# Beaver AI relational system of record
DATABASE_URL=postgresql://beaver:beaver@localhost:5432/beaver_ai

# Firebase Web App (public client identifiers, still managed through environment)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin verifies ID tokens and manages identity deletion.
# Local development: use Application Default Credentials or set the emulator.
FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# GOOGLE_APPLICATION_CREDENTIALS=C:\secure\firebase-service-account.json
